{
  "manifest_version": 3,
  "name": "RentIQ MagicBricks Capture",
  "version": "1.1.0",
  "description": "Wait for manual CAPTCHA completion, auto-scroll MagicBricks results, and send loaded rental listings to RentIQ.",
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://www.magicbricks.com/*",
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "RentIQ manual capture fallback",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.magicbricks.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
